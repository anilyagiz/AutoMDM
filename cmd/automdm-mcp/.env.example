# AutoMDM MCP Server — Configuration Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: the Makefile targets (make serve, call, tools, posture) load this
# .env; the binary itself only reads its environment. Claude Desktop runs
# the binary in stdio mode and reads its env from the `env` block of
# claude_desktop_config.json — see README.md for the JSON template.

# ── Server ────────────────────────────────────────────────────────────────────

# Port for the HTTP listener, Streamable HTTP and SSE (ignored in stdio mode)
PORT=8080

# Bearer token MCP clients must send in the Authorization header.
# Required at startup on every transport, including stdio. The server refuses
# to start without it. Generate with:
#   openssl rand -hex 32
MCP_AUTH_TOKEN=YOUR_MCP_AUTH_TOKEN

# Alternative: read MCP_AUTH_TOKEN from a file. When set, MCP_AUTH_TOKEN_FILE
# wins over MCP_AUTH_TOKEN. Useful for systemd LoadCredential, Docker secrets,
# or any setup where the token should not appear in process env.
# MCP_AUTH_TOKEN_FILE=/run/secrets/mcp_auth_token

# ── AutoMDM ─────────────────────────────────────────────────────────────────────

# Base URL of your AutoMDM instance (include scheme; include port if non-standard)
AUTOMDM_BASE_URL=https://your-team.example.com

# AutoMDM API token — generate one in AutoMDM under Settings > Integrations > API.
# Docs: https://automdm.com/docs/using-automdm/rest-api#authentication
#
# MUST be an API-only AutoMDM user: the MCP refuses to start otherwise.
# API-only users have no UI session, their own audit identity,
# and can be scoped to only the endpoints/teams the MCP needs.
#
# LEAST PRIVILEGE: use the lowest AutoMDM role that covers the tools you use.
# An observer token covers all the tools, except for `run_live_query` which needs observer-plus.
# No maintainer or admin role is required.
AUTOMDM_API_KEY=YOUR_AUTOMDM_API_KEY

# ── Logging ───────────────────────────────────────────────────────────────────

# Verbosity: debug | info | warn | error
LOG_LEVEL=info

# ── Live queries ──────────────────────────────────────────────────────────────

# How long run_live_query waits for hosts to report before returning. Accepts
# any Go duration string (e.g. 25s, 1m). Multi-host runs stop early once every
# online host has responded; this is just the upper bound. Mirrors the same
# variable on the AutoMDM server — keep this >= the server's value. Default 25s.
# AUTOMDM_LIVE_QUERY_REST_PERIOD=25s

# ── TLS (only if your AutoMDM uses a self-signed cert; pick AT MOST one) ────────

# Option A: Skip TLS verification — DEV/TEST ONLY, never use in production.
# Server logs an error if AUTOMDM_BASE_URL isn't a localhost address when this is set.
# AUTOMDM_TLS_SKIP_VERIFY=true

# Option B: Trust a custom CA certificate (recommended for self-signed AutoMDM).
# Path to a PEM-encoded certificate.
# AUTOMDM_CA_FILE=/path/to/ca.pem
