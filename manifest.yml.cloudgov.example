applications:
- name: automdm
  memory: 512m
  disk_quota: 2g
  instances: 1
  timeout: 120
  health-check-type: process
  command: |
    export AUTOMDM_MYSQL_USERNAME=$( echo $VCAP_SERVICES | jq -r '.["aws-rds"][].credentials.username')  && \
    export AUTOMDM_MYSQL_ADDRESS=$( echo $VCAP_SERVICES | jq -r '.["aws-rds"][].credentials.host') && \
    export AUTOMDM_MYSQL_DATABASE=$( echo $VCAP_SERVICES | jq -r '.["aws-rds"][].credentials.db_name') && \
    export AUTOMDM_MYSQL_PASSWORD=$( echo $VCAP_SERVICES | jq -r '.["aws-rds"][].credentials.password') && \
    export AUTOMDM_REDIS_ADDRESS=$( echo $VCAP_SERVICES | jq -r '.["aws-elasticache-redis"][].credentials.host + ":" + .["aws-elasticache-redis"][].credentials.port') && \
    export AUTOMDM_REDIS_PASSWORD$( echo $VCAP_SERVICES | jq -r '.["aws-elasticache-redis"][].credentials.password') && \
    automdm prepare --no-prompt=true db && \
    automdm serve
  docker:
    image: automdm/automdm:latest
  services:
    - automdm-mysql
    - automdm-redis
  env:
    AUTOMDM_LOGGING_JSON: true
    AUTOMDM_LOGGING_DEBUG: true
    AUTOMDM_REDIS_USE_TLS: true
    AUTOMDM_SERVER_TLS: false
    AUTOMDM_REDIS_CONNECT_RETRY_ATTEMPTS: 3
    # AUTOMDM_FIREHOSE_STATUS_STREAM: FALSE
    # AUTOMDM_FIREHOSE_RESULT_STREAM: 
    # AUTOMDM_FIREHOSE_REGION:
    # AUTOMDM_OSQUERY_STATUS_LOG_PLUGIN"
    # AUTOMDM_OSQUERY_RESULT_LOG_PLUGIN"
    # AUTOMDM_VULNERABILITIES_DATABASES_PATH: 
    # AUTOMDM_S3_BUCKET: 
    # AUTOMDM_S3_PREFIX:
    # AUTOMDM_LICENSE_KEY:

# Add the following to the command if needed     # printenv && \ 
