# Slack
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# GitHub
GITHUB_TOKEN=ghp_your_github_token
GITHUB_REPO=automdm/automdm
GITHUB_BASE_BRANCH=main
GITOPS_BASE_PATH=it-and-security
GITHUB_BOT_USERNAME=your-bot-github-username

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key
ANTHROPIC_MODEL=claude-opus-5-5

# Webhook
GITHUB_WEBHOOK_SECRET=your-webhook-secret
PORT=3000

# CI auto-fix (set to false to disable)
GITOPS_CI_CHECK_NAME=automdm-gitops
CI_AUTO_FIX=true

# AutoMDM's MCP server (built into AutoMDM Premium)
AUTOMDM_MCP_URL=https://automdm.example.com/api/v1/automdm/mcp
AUTOMDM_MCP_AUTH_TOKEN=your-api-only-user-token