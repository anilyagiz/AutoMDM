# MySQL Configuration
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_DATABASE=automdm
MYSQL_USER=automdm
MYSQL_PASSWORD=change_this_team_password

# AutoMDM Server Configuration
# Generate a random key with: openssl rand -base64 32
AUTOMDM_SERVER_PRIVATE_KEY=change_this_private_key

# AutoMDM HTTP Listener Configuration
AUTOMDM_SERVER_ADDRESS=0.0.0.0
AUTOMDM_SERVER_PORT=1337

# TLS Configuration
# Set to 'true' if AutoMDM handles TLS directly (requires certificates in ./certs/)
# Set to 'false' if using a reverse proxy or load balancer for TLS termination
AUTOMDM_SERVER_TLS=true

# TLS Certificate paths (only needed if AUTOMDM_SERVER_TLS=true)
AUTOMDM_SERVER_CERT=/automdm/automdm.crt
AUTOMDM_SERVER_KEY=/automdm/automdm.key

# AutoMDM License (optional - leave empty for free tier)
AUTOMDM_LICENSE_KEY=

# AutoMDM Session & Logging
AUTOMDM_SESSION_DURATION=24h
AUTOMDM_LOGGING_JSON=true

# AutoMDM Osquery Configuration
AUTOMDM_OSQUERY_STATUS_LOG_PLUGIN=filesystem
AUTOMDM_FILESYSTEM_STATUS_LOG_FILE=/logs/osqueryd.status.log
AUTOMDM_FILESYSTEM_RESULT_LOG_FILE=/logs/osqueryd.results.log
AUTOMDM_OSQUERY_LABEL_UPDATE_INTERVAL=1h

# AutoMDM Vulnerabilities
AUTOMDM_VULNERABILITIES_CURRENT_INSTANCE_CHECKS=yes
AUTOMDM_VULNERABILITIES_DATABASES_PATH=/vulndb
AUTOMDM_VULNERABILITIES_PERIODICITY=1h

# S3 Configuration (optional - leave empty if not using S3)
AUTOMDM_S3_SOFTWARE_INSTALLERS_BUCKET=
AUTOMDM_S3_SOFTWARE_INSTALLERS_ACCESS_KEY_ID=
AUTOMDM_S3_SOFTWARE_INSTALLERS_SECRET_ACCESS_KEY=
AUTOMDM_S3_SOFTWARE_INSTALLERS_FORCE_S3_PATH_STYLE=
AUTOMDM_S3_SOFTWARE_INSTALLERS_ENDPOINT_URL=
AUTOMDM_S3_SOFTWARE_INSTALLERS_REGION=
